# ============================================================
# CodeMind Environment Configuration
# ============================================================

# 1. Groq Configuration (Ultra-fast Conversational Brain when configured)
# OPTIONAL: Your Groq API Key
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# 2. OpenAI Configuration (Maya's Conversational Brain)
# REQUIRED: Your OpenAI API Key to power Maya's conversational intelligence.
OPENAI_API_KEY=your_openai_api_key_here

# OPTIONAL: Model name (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# 3. Google Gemini Configuration (Visualization Generation Only)
# OPTIONAL: Your Google Gemini API Key for algorithm and data structure visualizer.
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Gemini model name (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# 4. NVIDIA NIM Configuration (Conversational Brain alternative/fallback)
# OPTIONAL: Your NVIDIA NIM API Key
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# 5. Database URL (defaults to SQLite database/codemind.db)
# DATABASE_URL=sqlite:///database/codemind.db

# 6. SMTP Email Delivery Configuration (Account creation OTP, Verification & Password Recovery)
# REQUIRED in production for student registration OTP email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true

# 7. Encryption At Rest for User Groq API Keys (Server-side AES-128-CBC + HMAC-SHA256)
# Auto-derived from CODEMIND_SECRET_KEY, SECRET_KEY, or auto-generated if omitted
CODEMIND_SECRET_KEY=your_server_secret_key_here
# Optional explicit 32-byte url-safe base64 Fernet key:
# CODEMIND_ENCRYPTION_KEY=your_fernet_key_here
