# ============================================================
# CodeMind Environment Configuration
# ============================================================

# 1. OpenAI Configuration (Maya's Conversational Brain)
# REQUIRED: Your OpenAI API Key to power Maya's conversational intelligence.
OPENAI_API_KEY=your_openai_api_key_here

# OPTIONAL: Model name (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# 2. Google Gemini Configuration (Visualization Generation Only)
# OPTIONAL: Your Google Gemini API Key for algorithm and data structure visualizer.
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Gemini model name (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# 3. Database URL (defaults to SQLite database/codemind.db)
# DATABASE_URL=sqlite:///database/codemind.db
